{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spai-adjudicator/output",
  "title": "Adjudicator output",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineNumber", "reasonCode", "selectedProductCode", "confidence",
                     "justification", "complianceNotes", "requiresHuman"],
        "properties": {
          "lineNumber": { "type": "integer", "minimum": 1 },
          "reasonCode": {
            "type": "string",
            "enum": ["DISCONTINUED_SUB", "LEADTIME_SUB", "STOCKOUT_SUB", "CODE_UNRECOGNISED",
                     "AMBIGUOUS_SPEC", "DIM_MISMATCH", "COMPLIANCE_FAIL", "NO_EQUIVALENT"]
          },
          "selectedProductCode": { "type": ["string", "null"], "pattern": "^MCS-[0-9]{4}$" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "justification": { "type": "string", "minLength": 1 },
          "complianceNotes": { "type": "string" },
          "requiresHuman": { "type": "boolean" }
        }
      }
    }
  }
}
